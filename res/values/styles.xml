<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.StatusBar.EventContent"/>
  <style name="TextAppearance.Compat.Notification.Info" parent="@style/TextAppearance.Compat.Notification">
    <item name="android:textSize">12.0sp</item>
    <item name="android:textColor">?android:textColorSecondary</item>
  </style>
  <style name="TextAppearance.Compat.Notification.Info.Media" parent="@style/TextAppearance.Compat.Notification.Info"/>
  <style name="TextAppearance.Compat.Notification.Media" parent="@style/TextAppearance.Compat.Notification"/>
  <style name="TextAppearance.Compat.Notification.Time" parent="@style/TextAppearance.Compat.Notification">
    <item name="android:textSize">12.0sp</item>
    <item name="android:textColor">?android:textColorSecondary</item>
  </style>
  <style name="TextAppearance.Compat.Notification.Time.Media" parent="@style/TextAppearance.Compat.Notification.Time"/>
  <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.StatusBar.EventContent.Title"/>
  <style name="TextAppearance.Compat.Notification.Title.Media" parent="@style/TextAppearance.Compat.Notification.Title"/>
  <style name="Widget.Compat.NotificationActionContainer" parent=""/>
  <style name="Widget.Compat.NotificationActionText" parent=""/>
  <style name="BallonTipsStyle">
    <item name="android:shadowColor">#aa000000</item>
    <item name="android:shadowDx">0.0</item>
    <item name="android:shadowDy">0.0</item>
    <item name="android:shadowRadius">0.0</item>
  </style>
  <style name="ImageQualityControlTextDropShadow">
    <item name="android:shadowColor">#ff000000</item>
    <item name="android:shadowDx">0.0</item>
    <item name="android:shadowDy">1.0</item>
    <item name="android:shadowRadius">4.0</item>
  </style>
  <style name="OnScreenTextDropShadow">
    <item name="android:shadowColor">#80000000</item>
    <item name="android:shadowDx">0.0</item>
    <item name="android:shadowDy">1.0</item>
    <item name="android:shadowRadius">1.0</item>
  </style>
  <style name="SelfTimerTextDropShadow">
    <item name="android:shadowColor">#ff000000</item>
    <item name="android:shadowDx">0.0</item>
    <item name="android:shadowDy">1.0</item>
    <item name="android:shadowRadius">3.0</item>
  </style>
  <style name="SomcCamera.Dialog.Button.Borderless.Colored" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
    <item name="android:textSize">14.0sp</item>
    <item name="android:textColor">@color/rotatable_dialog_button_text_color</item>
    <item name="android:minWidth">64.0dip</item>
    <item name="android:minHeight">48.0dip</item>
  </style>
  <style name="SomcCameraTextViewStyle" parent="@android:style/Widget.TextView">
    <item name="android:fontFamily">sans-serif</item>
  </style>
  <style name="SomcCameraTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:textViewStyle">@style/SomcCameraTextViewStyle</item>
    <item name="android:textSize">14.0dip</item>
    <item name="android:textStyle">normal</item>
    <item name="android:textColor">@color/default_text_col</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:alertDialogTheme">@style/Theme.SomcCamera.AlertDialog</item>
    <item name="android:buttonBarStyle">@android:style/Holo.ButtonBar</item>
    <item name="android:buttonBarButtonStyle">?android:borderlessButtonStyle</item>
    <item name="android:textDirection">locale</item>
    <item name="android:layoutDirection">locale</item>
    <item name="android:windowTranslucentStatus">false</item>
    <item name="android:windowTranslucentNavigation">false</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
  <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info"/>
  <style name="TextAppearance.Compat.Notification.Line2.Media" parent="@style/TextAppearance.Compat.Notification.Info.Media"/>
  <style name="TextAppearance.SomcCamera.BallonTipsStyleLarge" parent="@style/BallonTipsStyle">
    <item name="android:textSize">16.0dip</item>
  </style>
  <style name="TextAppearance.SomcCamera.BallonTipsStyleMedium" parent="@style/BallonTipsStyle">
    <item name="android:textSize">14.0dip</item>
  </style>
  <style name="TextAppearance.SomcCamera.BallonTipsStyleSmall" parent="@style/BallonTipsStyle">
    <item name="android:textSize">12.0dip</item>
  </style>
  <style name="TextAppearance.SomcCamera.Dialog.Medium" parent="@android:style/TextAppearance.DeviceDefault.Medium">
    <item name="android:textSize">16.0sp</item>
  </style>
  <style name="TextAppearance.SomcCamera.Dialog.Title" parent="@android:style/TextAppearance.DialogWindowTitle">
    <item name="android:textSize">20.0sp</item>
  </style>
  <style name="TextAppearance.SomcCamera.Large" parent="@style/OnScreenTextDropShadow">
    <item name="android:textSize">16.0dip</item>
  </style>
  <style name="TextAppearance.SomcCamera.Medium" parent="@style/OnScreenTextDropShadow">
    <item name="android:textSize">14.0dip</item>
  </style>
  <style name="TextAppearance.SomcCamera.PermissionDialog.Default" parent="@android:style/TextAppearance.DeviceDefault">
    <item name="android:textSize">16.0sp</item>
  </style>
  <style name="TextAppearance.SomcCamera.PermissionDialog.Medium" parent="@android:style/TextAppearance.DeviceDefault.Medium"/>
  <style name="TextAppearance.SomcCamera.PermissionDialog.Small" parent="@android:style/TextAppearance.DeviceDefault.Small"/>
  <style name="TextAppearance.SomcCamera.ScrollableTextDialog" parent="@android:style/TextAppearance.DeviceDefault">
    <item name="android:textSize">16.0sp</item>
  </style>
  <style name="TextAppearance.SomcCamera.Small" parent="@style/OnScreenTextDropShadow">
    <item name="android:textSize">12.0dip</item>
  </style>
  <style name="Theme.IAPTheme" parent="@android:style/Theme">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
  <style name="Theme.SomcCamera.AlertDialog" parent="@android:style/Theme.DeviceDefault.Dialog.MinWidth">
    <item name="android:textAppearanceMedium">@style/TextAppearance.SomcCamera.Dialog.Medium</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowTitleStyle">@style/TextAppearance.SomcCamera.Dialog.Title</item>
    <item name="android:windowFullscreen">?android:windowNoTitle</item>
    <item name="android:buttonBarButtonStyle">@style/SomcCamera.Dialog.Button.Borderless.Colored</item>
    <item name="android:windowCloseOnTouchOutside">false</item>
    <item name="android:elevation">10.0dip</item>
  </style>
  <style name="TutorialText">
    <item name="android:textColor">@color/tutorial_text_color</item>
    <item name="android:lineSpacingMultiplier">1.2</item>
  </style>
  <style name="WindowAnimationDeviceDefaultDialogLandscape">
    <item name="android:windowEnterAnimation">@animator/somc_dialog_popup_enter</item>
    <item name="android:windowExitAnimation">@animator/somc_dialog_popup_exit_landscape</item>
  </style>
  <style name="WindowAnimationDeviceDefaultDialogPortrait">
    <item name="android:windowEnterAnimation">@animator/somc_dialog_popup_enter</item>
    <item name="android:windowExitAnimation">@animator/somc_dialog_popup_exit_portrait</item>
  </style>
  <style name="capturing_mode_text_style">
    <item name="android:textColor">#fffafafa</item>
    <item name="android:shadowColor">#aa000000</item>
    <item name="android:shadowDx">1.5</item>
    <item name="android:shadowDy">1.5</item>
    <item name="android:shadowRadius">0.1</item>
    <item name="android:textIsSelectable">false</item>
    <item name="android:fontFamily">sst</item>
    <item name="android:textDirection">locale</item>
  </style>
</resources>
